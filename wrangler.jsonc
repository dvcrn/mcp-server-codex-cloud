{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-server-codex-cloud",
  "main": "worker/index.ts",
  "account_id": "02c07a2514d9a25f58c78a180bb8c6f3",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexAccount"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CodexEgress"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["CodexAccount", "CodexEgress"]
    }
  ],
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "CODEX_AUTH",
      "id": "179d6d51004e46898f0d40385f88f1f4"
    }
  ]
}
