{
  "description": "Format files after Codex edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- bun \"$(git rev-parse --show-toplevel)/.agent-hooks/format-after-edit.ts\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ]
  }
}
