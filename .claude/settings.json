{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- bun \"$CLAUDE_PROJECT_DIR/.agent-hooks/format-after-edit.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
